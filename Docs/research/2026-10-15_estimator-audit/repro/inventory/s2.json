{
"keys":"(()=>{const names=['Post Concrete (60lb bag)','Gate Post Concrete (60lb bag)','Post Concrete (80lb bag)','2x4 Top Rail','2x4 Bottom Rail','2x4 Mid Rail','Bottom Rail 1-5/8\"','Terminal-size Brace Band','Line-size Brace Band','Brace Wire','Gate Post 10.5\\' (104\" cut)','Vinyl Post 9\\'','Post 4x4x9\\'','Barb Arm vertical','Welded Wire 2x4','Tension Wire 9ga','Razor Ribbon Coil','Chain Link Fabric (48\")','Truss Rod','Truss Rod Connector (turnbuckle-style, threaded)','Cantilever w/ Hardware','Temp Panel 6x12','Hog Wire Welded Panel (red-top)','Exterior Screws (pickets)','Gravel','Line Post Concrete','Post Concrete Bag'];return names.map(n=>[n,normalizeMatKey(n),resolveKey(n),lookupCost(n)]);})()",
"concrete_price_edit":"(()=>{build('chainlink',48,10);COST_DB['post concrete bag'].cost=1;const a=lookupCost('Post Concrete (60lb bag)');COST_DB['post'].cost=99;const b=lookupCost('Post Concrete (60lb bag)');COST_DB=JSON.parse(JSON.stringify(DEFAULT_COST_DB));return {afterEditingConcreteBag:a,afterEditingWoodPost:b};})()",
"legacy_embed28":"(()=>{const st=JSON.parse(JSON.stringify(snapshotState()));build('chainlink',72,100,[[40,44,'walk']]);const snap=snapshotState();snap.elements.forEach(e=>{['specs','runSpecs'].forEach(k=>{if(e[k]){delete e[k].postEmbedIn;delete e[k].postEmbedDirty;e[k].embedDepthIn=28;}})});applyState(snap);const bom=calcAutoMaterials();const v=validateProject({requireClient:false});return {concrete:bom.filter(r=>/Concrete/.test(r.name)),embed:fenceRunById('r0').specs.postEmbedIn,errors:v.errors.map(e=>e.code),warnings:v.warnings.map(w=>w.code)};})()",
"embed_override_20":"(()=>{const r=build('chainlink',48,100,[],{mutate:s=>{s.postEmbedIn.terminal=20;s.postEmbedDirty.terminal=true;}});return r.bom.filter(x=>/oncrete/.test(x.name)).concat([{validate:validateProject({requireClient:false}).errors.map(e=>e.code)}]);})()",
"legacy_type_wood":"(()=>{build('chainlink',48,100);const snap=snapshotState();snap.elements.forEach(e=>{if(e.type==='fence')e.fenceType='barbedwire';});applyState(snap);const P=computePricing();return {bom:calcAutoMaterials(),labor:P.laborLines,mat:P.matCost,total:P.clientTotal,errors:validateProject({requireClient:false}).errors.map(e=>e.code)};})()",
"legacy_type_unknown":"(()=>{build('chainlink',48,100);const snap=snapshotState();snap.elements.forEach(e=>{if(e.type==='fence')e.fenceType='privacy';});applyState(snap);const P=computePricing();return {bom:calcAutoMaterials(),labor:P.laborLines,total:P.clientTotal,errors:validateProject({requireClient:false}).errors.map(e=>e.code)};})()",
"square_closed":"build('chainlink',48,0,[],{points:[{x:0,y:0},{x:40*GRID_FT,y:0},{x:40*GRID_FT,y:40*GRID_FT},{x:0,y:40*GRID_FT},{x:0,y:0}]})",
"collinear_two_runs":"build('chainlink',48,0,[],{points:[{x:0,y:0},{x:50*GRID_FT,y:0},{x:100*GRID_FT,y:0}]})",
"gate_at_run_end":"build('chainlink',48,100,[[96,100,'walk']])",
"adjacent_gates":"build('chainlink',48,100,[[40,44,'walk'],[44,56,'doubledrive']])",
"gate_short_section":"build('ornamental',48,100,[[41,45,'walk'],[49,61,'doubledrive']])",
"cantilever":"build('chainlink',72,100,[[40,64,'cantilever']])",
"autopost_off":"build('chainlink',48,100,[],{noAuto:true})",
"manual_post":"(()=>{const r=build('chainlink',48,100,[],{noAuto:true});S.elements.push({type:'post',pos:{x:50*GRID_FT,y:0},fenceType:'chainlink'});const st=getStats();return {line:st.linePosts,bomPosts:calcAutoMaterials().filter(x=>/Post/.test(x.name))};})()",
"cl96":"build('chainlink',96,100)",
"cl120":"build('chainlink',120,100)",
"cl42":"build('chainlink',42,100)",
"cl72_barbed_razor_tw":"build('chainlink',72,100,[[40,44,'walk']],{mutate:s=>{s.addons.add('barbed-wire');s.addons.add('razor-ribbon');s.addons.add('tension-wire');s.hasTrussRod=true;}})",
"cl45_short_last_bay":"build('chainlink',48,45)",
"string_qty":"(()=>{build('chainlink',48,10);S.materials=[{name:'Post Cap',qty:'3',unit:'ea'},{name:'Post Cap',qty:'3 ',unit:'ea'},{name:'Post Cap',qty:'1e2',unit:'ea'},{name:'Post Cap',qty:'',unit:'ea'},{name:'Chain Link Fabric',qty:'1',unit:'roll'},{name:'Mystery Widget',qty:'2',unit:'ea'}];const P=computePricing();return {lines:P.matLines.filter(l=>l.source==='manual'),unknown:P.unknown,saved:JSON.parse(JSON.stringify(snapshotState().materials))};})()",
"mat_units":"[...document.querySelectorAll('#mat-unit option')].map(o=>o.value)",
"bagweight80":"(()=>{build('chainlink',48,10);FOOTING.bagWeightLb=80;const b=calcAutoMaterials().filter(r=>/oncrete/.test(r.name));const c=b.map(r=>[r.name,resolveKey(r.name),lookupCost(r.name)]);FOOTING.bagWeightLb=60;return c.concat(b.map(r=>r.qty));})()",
"wood_mixed_corner":"(()=>{localStorage.clear();S.elements=[];selectFenceType('chainlink');const a=cloneRunSpecs(S.specs);const r1={type:'fence',start:{x:0,y:0},end:{x:50*GRID_FT,y:0},fenceType:'chainlink',runId:'a',specs:a,postSpacing:10,autoPostSpacing:10};selectFenceType('woodprivacy');const b=cloneRunSpecs(S.specs);const r2={type:'fence',start:{x:50*GRID_FT,y:0},end:{x:50*GRID_FT,y:50*GRID_FT},fenceType:'woodprivacy',runId:'b',specs:b,postSpacing:8,autoPostSpacing:8};S.elements=[r1,r2,...autoPostsForRun(r1.start,r1.end,10,'chainlink','a',a),...autoPostsForRun(r2.start,r2.end,8,'woodprivacy','b',b)];return {stats:Object.values(getStats().byRunId),bom:calcAutoMaterials().filter(r=>/Post|Tension Bar/.test(r.name))};})()",
"woodsplit_facecheck":"build('woodsplit3fb',null,100,[],{mutate:s=>{s.hasFaceBoard=false;}}).bom.filter(r=>/Face/.test(r.name))",
"temp_default_height":"(()=>{localStorage.clear();location.hash='';S.elements=[];S.specs=hydrateRunSpecs({...S.specs});selectFenceType('chainlink');S.specs.heightIn=48;applyHeightDrivenSpecs({specs:S.specs});selectFenceType('temporary');const t=S.specs.heightIn;selectFenceType('vinylsplit2');return {tempHeight:t,vsplitHeight:S.specs.heightIn,postH:S.specs.postHeightIn};})()"
}
